{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoXLR Discord Sync",
  "identifier": "com.powange.goxlr-discord-sync",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "publisher": "powange",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Mirror your GoXLR mute controls to Discord",
    "longDescription": "GoXLR Discord Sync connects to GoXLR Utility and to the Discord client: the Cough button mutes your microphone in Discord, muting the Chat channel deafens you, and GoXLR buttons can trigger Discord actions.",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGMkEwM0MyMEMwQUNGREQKUldUZHp3b013Z01xM3k2Q2xpQkVJMTBpTzVNOTdpQzNNUVFVNkJ0TTZORlpBbUJFWnRUdElwVTUK",
      "endpoints": ["https://github.com/powange/goxlr-discord-sync/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
