<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for GoXLR Discord Sync.
  Paste it in SignPath (Project > Artifact configurations). The CI uploads each
  executable on its own (GoXLR_Discord_Sync.exe, then GoXLR_Setup.exe), packed
  in a ZIP by actions/upload-artifact; this signs the .exe inside.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
